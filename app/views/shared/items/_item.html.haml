%tr
  %td= item.name
  %td= item.min_quantity
  %td
    .d-flex.justify-content-end.gap-2
      = render IconButtonComponent.new(title: 'Modifier', path: edit_location_path(item), icon: 'bi bi-pencil', turbo: 'modal')
      = render IconButtonComponent.new(title: 'Supprimer', path: item_path(item), icon: 'bi bi-trash text-danger', delete: true)